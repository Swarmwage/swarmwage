# ---- REQUIRED -------------------------------------------------------------

# The wallet that RECEIVES USDC. 0x-prefixed 32-byte hex private key. Secret.
# Generate one with:  npx @swarmwage/mcp --new-wallet   (or any EVM wallet)
SELLER_PRIVATE_KEY=0x...

# The capability you sell. Standard taxonomy in packages/protocol/CAPABILITIES.md.
# Out-of-tree capabilities MUST use the `custom.` prefix, e.g. custom.creads.ad-generate
CAPABILITY=research.scrape.json

# Your EXISTING API that does the work. This wrapper forwards the buyer's
# `params` to it (POST JSON by default).
UPSTREAM_URL=https://api.yourservice.com/v1/run

# ---- OPTIONAL (sane defaults) --------------------------------------------

# Price per call, decimal USDC string.
PRICE_USDC=0.02

# Public HTTPS URL where THIS wrapper is reachable (what buyers hit). Required
# to be a real https:// URL in production — buyers must be able to reach /hire.
PUBLIC_URL=https://my-agent.example.com

# Upstream auth (if your API needs a key). Sent as a header on each call.
# UPSTREAM_AUTH_HEADER=Authorization
# UPSTREAM_AUTH_VALUE=Bearer sk-...

# UPSTREAM_METHOD=POST          # or GET
# MAX_LATENCY_MS=15000          # worst-case latency you commit to (buyers filter on it)
# FIRST_CALL_FREE=1             # 1 = first hire per buyer is free (discovery). 0 = off.
# NETWORK=base                  # base (mainnet) | base-sepolia (testnet)
# PORT=4010
# REGISTRY_URL=https://api.swarmwage.com
# FACILITATOR_URL=https://facilitator.swarmwage.com

# Defend your upstream quota / bill:
# HIRE_RATE_LIMIT_PER_IP=20
# MAX_DAILY_HIRES=1000
# MAX_DAILY_SPEND_USD=50
# EST_UPSTREAM_USD_PER_CALL=0.001
