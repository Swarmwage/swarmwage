# Swarmwage Indexer — environment configuration
# Copy to `.env` for local development.

# HTTP listen port for the /health endpoint
PORT=3002

# Target network — "base" (mainnet) or "base-sepolia" (testnet)
NETWORK=base-sepolia

# JSON-RPC endpoint for the selected network. Optional: when omitted the
# service falls back to the viem default RPC for the chain. For production
# use, an Alchemy / QuickNode / Infura endpoint is strongly recommended;
# the public default RPC has aggressive rate limits and short log windows.
# RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Base URL of the Swarmwage Registry, used to resolve recipient addresses
# to agent identities. The indexer writes `recipient_agent_id = null` when
# the registry returns 404 or is unreachable.
REGISTRY_URL=http://localhost:3010

# First block to index. When omitted the indexer starts from the current
# chain head on first boot and persists progress in the store.
# START_BLOCK=12345678

# Indexing loop tick (seconds). At each tick the indexer asks the RPC for
# the latest block, computes the next range to scan, and writes any new
# Transfer events to the store.
INDEX_INTERVAL_SECONDS=60

# Max blocks to request from `eth_getLogs` in a single call. Public RPC
# endpoints typically cap this at 500–2000; Alchemy free tier allows 2000.
MAX_BLOCK_RANGE=2000

# Number of blocks to lag behind the chain head before treating a block as
# final. Protects the `transactions` table from short reorgs on Base —
# the cursor only advances to `latest - CONFIRMATION_DEPTH`. Default 1
# (Day-7 minimum). At scale (high-volume production), 12 is a safe choice.
CONFIRMATION_DEPTH=1

# Optional Postgres connection string. When omitted, the service uses an
# in-process in-memory store (suitable for development only).
# DATABASE_URL=postgres://user:pass@host:5432/swarmwage_indexer

# Optional path to a JSON seed of known external (non-Swarmwage) recipient
# addresses. Matching transfers are tagged with `recipient_source` /
# `recipient_label` (kept separate from `recipient_agent_id`) so the indexer
# can attribute on-chain volume to third-party x402 endpoints without
# registering them as agents. Shape: [{ "address","source","label","category" }].
# When omitted, external attribution is disabled (safe no-op).
# EXTERNAL_ADDRESSES_PATH=/path/to/external-addresses.json

# Optional log level — one of: debug | info | warn | error
LOG_LEVEL=info
