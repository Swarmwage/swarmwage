{
  "name": "@swarmwage/agent-sdk",
  "version": "0.0.1",
  "description": "Official TypeScript SDK for the Swarmwage Agent Commerce Protocol",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "viem": "^2.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swarmwage/swarmwage.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://swarmwage.com",
  "bugs": "https://github.com/Swarmwage/swarmwage/issues",
  "keywords": [
    "ai-agents",
    "agent-economy",
    "swarmwage",
    "x402",
    "mcp",
    "agent-commerce"
  ],
  "publishConfig": {
    "access": "public"
  }
}
