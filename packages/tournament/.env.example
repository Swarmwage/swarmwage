#
# Tournament env template. Copy to .env (gitignored) and fill in.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Every value below is REQUIRED unless marked "optional". The agent-runner
# refuses to start if its provider key is missing.

# --- LLM provider API keys (1 key per provider — 6 providers, 10 agents) ---
# agent_01 = Claude Sonnet 4.6
# agent_02 = Claude Haiku 4.5
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# agent_03 = GPT-5
# agent_04 = GPT-5-mini
OPENAI_API_KEY=sk-proj-REPLACE_ME

# agent_05 = Gemini 2.5 Pro
GOOGLE_GENERATIVE_AI_API_KEY=REPLACE_ME

# agent_06 = Grok 4.3 (OpenAI-compatible, baseURL=https://api.x.ai/v1)
XAI_API_KEY=xai-REPLACE_ME

# agent_07 = DeepSeek Reasoner (OpenAI-compatible, baseURL=https://api.deepseek.com/v1)
DEEPSEEK_API_KEY=sk-REPLACE_ME

# agent_08 = Kimi K2 (OpenAI-compatible, baseURL=https://api.moonshot.ai/v1)
MOONSHOT_API_KEY=sk-REPLACE_ME

# agent_09 = Mistral Large 2 (native via @ai-sdk/mistral)
MISTRAL_API_KEY=REPLACE_ME

# agent_10 = Gemini 2.5 Flash (reuses the GOOGLE_GENERATIVE_AI_API_KEY above
# that already covers agent_05). Alibaba DashScope verification stalled
# 2026-05-24; if you later obtain the Qwen key, set ALIBABA_API_KEY below and
# flip agent_10 back to Qwen in packages/tournament/shared/src/roster.ts.
# ALIBABA_API_KEY=sk-REPLACE_ME

# --- On-chain settlement --------------------------------------------------
# Base mainnet RPC. Free public endpoint works; bump to Alchemy if rate-limited.
BASE_RPC_URL=https://mainnet.base.org
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/REPLACE_ME

# Facilitator gas-relay key — pays gas for the agents' EIP-3009 settlements.
# This wallet holds ETH only, NEVER USDC. ~0.01 ETH = ~30 hires covered.
# Generated by `pnpm wallets:generate` and funded out-of-band.
FACILITATOR_GAS_PRIVATE_KEY=0xREPLACE_ME

# --- Tournament parameters ------------------------------------------------
# Per-agent caps (enforced by wallet-svc — cannot be overridden by the LLM).
PER_AGENT_USDC_CAP=5
PER_AGENT_API_USD_CAP=8

# Tick interval (ms). 120000 = 2 minutes — 1440 ticks over 48h.
TICK_INTERVAL_MS=120000

# Agent IDs (orchestrator polls these). Keep in sync with docker-compose services.
AGENT_IDS=agent_01,agent_02,agent_03,agent_04,agent_05,agent_06,agent_07,agent_08,agent_09,agent_10
