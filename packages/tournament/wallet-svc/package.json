    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/__test__/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  }
}
