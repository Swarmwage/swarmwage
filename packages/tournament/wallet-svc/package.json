{
  "name": "@swarmwage/tournament-wallet-svc",
  "version": "0.0.1",
  "private": true,
  "description": "Sign-only wallet sidecar — holds N agent private keys, signs EIP-3009/EIP-712 on request, enforces per-wallet daily caps",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
