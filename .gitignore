/docs/architecture-notes/
/docs/ai-technical-board.md
/AGENTS.md
/.codex/
/.agents/

# Internal marketing asset — Remotion compositions for the launch video.
# Only the rendered MP4/PNG outputs ship publicly (Twitter, HN, Discord);
# source compositions stay local. Also excluded from pnpm workspace.
packages/video/

# Local MCP server config (project_ref is private project identifier)
/.mcp.json
# …except the Claude Code plugin's .mcp.json, which IS the canonical
# public artifact telling installers how to wire up @swarmwage/mcp.
!packages/plugin/.mcp.json

# Repo is pnpm-only; reject accidental npm-generated lockfiles
package-lock.json

# Tournament secrets — agent wallet private keys (encrypted at rest), tick logs,
# per-tournament settlement records before post-mortem is published. NEVER commit.
.tournament-secrets/
.tournament-backup/
packages/tournament/.wallets.json.enc
packages/tournament/.wallets.json
packages/tournament/memory/
packages/tournament/tick-logs/
packages/tournament/leaderboard/preview.html
